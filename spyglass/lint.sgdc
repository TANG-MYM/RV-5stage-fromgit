// ============================================================================
// lint.sgdc — SpyGlass Design Constraints for HiRiscy
// ----------------------------------------------------------------------------
// This file tells SpyGlass about clocks, resets, and design intent.
// ============================================================================

// ---- Primary clock ----------------------------------------------------------
current_design hiriscy_soc

// Define the main clock (adjust period/frequency as needed)
clock -name clk -period 10 -waveform {0 5}

// ---- Primary reset ----------------------------------------------------------
reset -name rst_n -value 0 -async

// ---- Black-box or special handling (if any) ---------------------------------
// Example: if you have a memory black-box, declare it here
// blackbox -module imem_rom
// blackbox -module dmem_sram

// End of constraints
