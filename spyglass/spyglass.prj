// ============================================================================
// spyglass.prj — SpyGlass Lint Project for HiRiscy (RV32I) Core
// ----------------------------------------------------------------------------
// Run from inside the spyglass/ directory:
//   spyglass -shell -tcl run_lint.tcl
// ============================================================================

// ---- Include directories ----------------------------------------------------
+incdir+../rtl/pkg
+incdir+../rtl/core

// ---- Source files (order does not matter for lint) -------------------------
-f ../sim/filelist.f

// ---- Top-level module -------------------------------------------------------
top hiriscy_soc

// ---- Common lint rulesets ---------------------------------------------------
// lint_rtl is the most widely used basic RTL lint rule set.
// You can add more rulesets as needed (e.g., STARC, RMM, or company rules).
ruleset lint_rtl

// ---- Output directory -------------------------------------------------------
write_data_dir ./results

// ---- Additional options -----------------------------------------------------
// Enable waiver file if you create one later
// -waiver_file waiver.waiver

// End of project file
